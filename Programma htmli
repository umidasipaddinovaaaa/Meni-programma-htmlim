
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Telegram Clone</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;font-family:Arial,sans-serif;
 background:#dce5ec;color:#222;
}
.app{
 display:flex;width:100%;height:100vh;
 max-width:1400px;margin:auto;background:white;
 box-shadow:0 0 20px #0002;
}
.sidebar{
 width:340px;border-right:1px solid #ddd;
 display:flex;flex-direction:column;
}
.header{
 height:65px;background:#fff;
 display:flex;align-items:center;
 padding:0 16px;gap:12px;
 border-bottom:1px solid #eee;
}
.logo{font-size:23px;font-weight:bold;color:#229ed9}
.search{
 margin:12px;padding:12px;border:0;
 border-radius:10px;background:#f0f2f5;
 outline:none;font-size:15px;
}
.contacts{overflow-y:auto;flex:1}
.contact{
 display:flex;align-items:center;
 padding:13px;gap:12px;cursor:pointer;
}
.contact:hover,.contact.active{background:#e8f4fa}
.avatar{
 width:48px;height:48px;border-radius:50%;
 background:#229ed9;color:white;
 display:grid;place-items:center;
 font-size:19px;font-weight:bold;
 flex-shrink:0;
}
.details{flex:1;min-width:0}
.name{font-weight:bold;margin-bottom:5px}
.last{
 color:#888;font-size:13px;
 white-space:nowrap;overflow:hidden;
 text-overflow:ellipsis;
}
.time{font-size:11px;color:#888}
.chat{
 flex:1;display:flex;flex-direction:column;
 min-width:0;
}
.chat-header{
 height:65px;display:flex;align-items:center;
 padding:0 20px;gap:12px;
 border-bottom:1px solid #eee;
}
.status{font-size:12px;color:#229ed9}
.messages{
 flex:1;overflow-y:auto;padding:20px;
 background:#e9f0f5;
 display:flex;flex-direction:column;gap:10px;
}
.message{
 max-width:75%;padding:11px 14px;
 border-radius:13px;background:white;
 align-self:flex-start;
 box-shadow:0 1px 2px #0001;
 word-break:break-word;
}
.message.mine{
 align-self:flex-end;background:#d8fdd2;
}
.msg-time{font-size:10px;color:#888;text-align:right;margin-top:5px}
.composer{
 display:flex;padding:12px;gap:10px;
 background:white;
}
.composer input{
 flex:1;border:0;background:#f1f3f5;
 padding:13px;border-radius:25px;outline:none;
 min-width:0;font-size:15px;
}
button{
 border:0;background:#229ed9;color:white;
 padding:12px 18px;border-radius:25px;
 cursor:pointer;font-weight:bold;
}
button:hover{background:#168ac0}
.mobile-back{display:none;background:none;color:#229ed9;padding:8px}
@media(max-width:650px){
 .sidebar{width:100%}
 .chat{display:none;width:100%}
 .app.chat-open .sidebar{display:none}
 .app.chat-open .chat{display:flex}
 .mobile-back{display:block}
}
</style>
</head>
<body>
<div class="app" id="app">
 <aside class="sidebar">
  <div class="header">
   <div class="logo">✈ Telegram</div>
  </div>
  <input class="search" id="search" placeholder="🔍 Qidirish...">
  <div class="contacts" id="contacts"></div>
 </aside>

 <main class="chat">
  <div class="chat-header">
   <button class="mobile-back" onclick="back()">←</button>
   <div class="avatar" id="chatAvatar">A</div>
   <div>
    <div class="name" id="chatName">Ali</div>
    <div class="status">online</div>
   </div>
  </div>
  <div class="messages" id="messages"></div>
  <div class="composer">
   <input id="input" placeholder="Xabar yozing...">
   <button onclick="sendMessage()">➤</button>
  </div>
 </main>
</div>

<script>
const chats=[
 {id:1,name:"Ali",avatar:"A",messages:[
  {text:"Salom! Qalaysan?",mine:false,time:"10:20"},
  {text:"Yaxshi, rahmat! 😊",mine:true,time:"10:21"}
 ]},
 {id:2,name:"Vali",avatar:"V",messages:[
  {text:"Bugun uchrashamizmi?",mine:false,time:"09:30"}
 ]},
 {id:3,name:"Malika",avatar:"M",messages:[
  {text:"Salom 👋",mine:false,time:"Kecha"}
 ]},
 {id:4,name:"Sardor",avatar:"S",messages:[
  {text:"Qanday yangiliklar?",mine:false,time:"Kecha"}
 ]}
];

let active=1;

function renderContacts(){
 const q=document.getElementById("search").value.toLowerCase();
 document.getElementById("contacts").innerHTML=chats
 .filter(c=>c.name.toLowerCase().includes(q))
 .map(c=>`
 <div class="contact ${c.id===active?'active':''}"
 onclick="openChat(${c.id})">
 <div class="avatar">${c.avatar}</div>
 <div class="details">
 <div class="name">${c.name}</div>
 <div class="last">${c.messages.at(-1)?.text||"Yangi chat"}</div>
 </div>
 <div class="time">${c.messages.at(-1)?.time||""}</div>
 </div>`).join("");
}

function openChat(id){
 active=id;
 const chat=chats.find(c=>c.id===id);
 document.getElementById("chatName").textContent=chat.name;
 document.getElementById("chatAvatar").textContent=chat.avatar;
 document.getElementById("app").classList.add("chat-open");
 renderMessages();
 renderContacts();
}

function renderMessages(){
 const chat=chats.find(c=>c.id===active);
 document.getElementById("messages").innerHTML=
 chat.messages.map((m,i)=>`
 <div class="message ${m.mine?'mine':''}"
 onclick="react(${i})"
 oncontextmenu="deleteMessage(event,${i})"
 title="Reaksiya uchun bosing, o‘chirish uchun o‘ng tugmani bosing">
 ${escapeHTML(m.text)}
 <div class="msg-time">${m.time}</div>
 </div>`).join("");
 const box=document.getElementById("messages");
 box.scrollTop=box.scrollHeight;
}

function escapeHTML(text){
 return text.replace(/[&<>"']/g,c=>({
 '&':'&amp;','<':'&lt;','>':'&gt;',
 '"':'&quot;',"'":'&#39;'
 })[c]);
}

function sendMessage(){
 const input=document.getElementById("input");
 const text=input.value.trim();
 if(!text)return;
 const chat=chats.find(c=>c.id===active);
 const now=new Date();
 chat.messages.push({
  text:text,mine:true,
  time:now.getHours()+":"+String(now.getMinutes()).padStart(2,"0")
 });
 input.value="";
 renderMessages();
 renderContacts();
}

function react(i){
 const chat=chats.find(c=>c.id===active);
 chat.messages[i].text+=" ❤️";
 renderMessages();
}

function deleteMessage(e,i){
 e.preventDefault();
 if(confirm("Xabarni o‘chirasizmi?")){
  chats.find(c=>c.id===active).messages.splice(i,1);
  renderMessages();
  renderContacts();
 }
}

function back(){
 document.getElementById("app").classList.remove("chat-open");
}

document.getElementById("input").addEventListener("keydown",e=>{
 if(e.key==="Enter")sendMessage();
});

document.getElementById("search").addEventListener("input",renderContacts);

renderContacts();
openChat(1);
</script>
</body>
</html>
